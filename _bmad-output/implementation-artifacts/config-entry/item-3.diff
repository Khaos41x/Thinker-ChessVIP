+    .status-card h1 { width:100%; margin:0; font-size:28px; line-height:36px; text-align:center; }
+    .status { display:grid; grid-template-columns:8px 40px; align-items:center; width:56px; gap:8px; font-size:12px; line-height:18px; color:var(--muted); }
+    .status::before { content:""; width:8px; height:8px; border-radius:50%; background:var(--accent); }
+    .status-card .compact-button { display:flex; align-items:center; justify-content:center; width:160px; height:32px; margin:0; padding:0 12px; font-size:11px; line-height:16px; text-decoration:none; }
