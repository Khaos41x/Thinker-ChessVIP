+    .status-card { width:min(100%,var(--status-max-width)); max-width:var(--status-max-width); margin:0; padding:calc(2 * var(--space)); display:grid; justify-items:center; gap:var(--space); border:1px solid var(--border); border-radius:var(--radius); background:var(--panel); color:#deded9; }
