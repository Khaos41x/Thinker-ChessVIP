+pixels=[]
+for r in after:
+ if r['width'] not in [1440,1086,800]:continue
+ mode='rand' if r['mode']=='Random' else 'max'
+ path=root/'after'/f"console-{r['width']}-{mode}-pacing{int(r['smartPacing'])}.png"
+ im=Image.open(path).convert('RGB');host=r['ancestors'][0]
