{
  "name": "thinker-analysis-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:engine": "node scripts/prepare-engine.mjs",
    "dev": "npm run prepare:engine && vite",
    "build": "npm run prepare:engine && vite build",
    "smoke:engine": "npm run prepare:engine && node scripts/smoke-engine.mjs",
    "smoke:scholar": "npm run prepare:engine && node scripts/smoke-engine.mjs --scholar",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "profile:eval-bar": "node scripts/profile-eval-bar.mjs",
    "build:userscript-eval-bar": "node scripts/build-userscript-eval-bar.mjs",
    "test:browser:eval-bar-v2": "node ../tests/browser/test_eval_bar_v2_chrome.mjs"
  },
  "dependencies": {
    "@lichess-org/chessground": "10.4.2",
    "@lichess-org/stockfish-web": "0.5.0",
    "chess.js": "1.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
